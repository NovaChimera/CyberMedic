<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Obsidian Purple Theme -->
    <Color x:Key="AccentColor">#b388ff</Color>
    <Color x:Key="AccentLightColor">#d1b3ff</Color>
    <Color x:Key="AccentDarkColor">#9575cd</Color>
    <Color x:Key="BackgroundColor">#1a1a2e</Color>
    <Color x:Key="SurfaceColor">#16213e</Color>
    <Color x:Key="CardColor">#0f3460</Color>
    <Color x:Key="TextColor">#e0e0e0</Color>
    <Color x:Key="SecondaryTextColor">#a0a0a0</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />

    <!-- Accent color overrides for WinUI controls -->
    <Color x:Key="SystemAccentColor">#b388ff</Color>
    <Color x:Key="SystemAccentColorLight1">#d1b3ff</Color>
    <Color x:Key="SystemAccentColorLight2">#e8d9ff</Color>
    <Color x:Key="SystemAccentColorLight3">#f5f0ff</Color>
    <Color x:Key="SystemAccentColorDark1">#9575cd</Color>
    <Color x:Key="SystemAccentColorDark2">#7e57c2</Color>
    <Color x:Key="SystemAccentColorDark3">#673ab7</Color>
</ResourceDictionary>

