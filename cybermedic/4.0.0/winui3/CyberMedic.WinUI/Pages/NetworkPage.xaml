<Page
    x:Class="CyberMedic.WinUI.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" Background="{StaticResource BackgroundBrush}">
            <TextBlock Text="Network &amp; Rete" Style="{StaticResource TitleTextBlockStyle}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Diagnostica rete, test connettività e gestione Wi-Fi." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Test Connettività" Click="ConnectivityButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Content="Info Rete" Click="NetworkInfoButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Content="Reset Rete" Click="ResetNetworkButton_Click" Background="#e94560" Foreground="White" />
            </StackPanel>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Risultato" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" Height="300" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
