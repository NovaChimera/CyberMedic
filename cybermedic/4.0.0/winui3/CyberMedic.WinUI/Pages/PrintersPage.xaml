<Page
    x:Class="CyberMedic.WinUI.Pages.PrintersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" Background="{StaticResource BackgroundBrush}">
            <TextBlock Text="Gestione Stampanti" Style="{StaticResource TitleTextBlockStyle}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Inventario stampanti e stato code di stampa." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Aggiorna Inventario" Click="RefreshButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Content="Pulisci Code" Click="ClearQueuesButton_Click" Background="#e94560" Foreground="White" />
            </StackPanel>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Stampanti" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <ListView x:Name="PrintersList" Height="300" Background="{StaticResource SurfaceBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" MinWidth="200" />
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Driver}" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" Height="150" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
