<Page
    x:Class="CyberMedic.WinUI.Pages.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" Background="{StaticResource BackgroundBrush}">
            <TextBlock Text="Maintenance" Style="{StaticResource TitleTextBlockStyle}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Pulizia temporanei e manutenzione sistema." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Analizza Spazio" Click="AnalyzeButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Content="Pulisci Temp" Click="CleanupButton_Click" Background="#e94560" Foreground="White" />
            </StackPanel>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
                <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" Height="300" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
