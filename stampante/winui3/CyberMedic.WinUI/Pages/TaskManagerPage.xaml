<Page
    x:Class="CyberMedic.WinUI.Pages.TaskManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" Background="{StaticResource BackgroundBrush}">
            <TextBlock Text="Task Manager" Style="{StaticResource TitleTextBlockStyle}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Monitoraggio risorse e gestione processi." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch x:Name="CpuToggle" Header="CPU Monitor" IsOn="True" Toggled="Toggle_Toggled" />
                <ToggleSwitch x:Name="RamToggle" Header="RAM Monitor" IsOn="True" Toggled="Toggle_Toggled" />
                <ToggleSwitch x:Name="DiskToggle" Header="Disk Monitor" IsOn="True" Toggled="Toggle_Toggled" />
                <ToggleSwitch x:Name="NetToggle" Header="Net Monitor" IsOn="True" Toggled="Toggle_Toggled" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Aggiorna Metriche" Click="RefreshButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Content="Top Processi" Click="TopProcessesButton_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
            </StackPanel>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Metriche" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="MetricsText" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Processi" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" Height="200" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
